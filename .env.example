# Copy this file to .env.local and fill in values from
# Supabase → Project Settings → API (or "API Keys").
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# "anon" or "publishable" key — safe to expose in the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" or "secret" key — SERVER ONLY. Never commit, never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
