# Copy this file to .env.local and fill in values from
# Supabase → Project Settings → API (or "API Keys").
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# "anon" or "publishable" key — safe to expose in the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" or "secret" key — SERVER ONLY. Never commit, never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Show the demo accounts (with password) on the login page. Turn OFF after a public demo.
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=true
# Password for all seeded demo accounts (server only). Defaults to GTFixIt-Demo-2026! if unset.
DEMO_ACCOUNT_PASSWORD=

# AI features (optional). SERVER ONLY: never prefix with NEXT_PUBLIC_. Without it, the app works without AI.
OPENAI_API_KEY=
# Optional: a different OpenAI model (default gpt-6-luna). AI_PROVIDER=off disables AI entirely.
# OPENAI_MODEL=
# AI_PROVIDER=off
